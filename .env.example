# =====================================================================
# Transactional Email Microservice — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# =====================================================================

# -------------------
# RabbitMQ
# -------------------
# Full AMQP connection URL (e.g. amqp://user:pass@localhost:5672)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Topic exchange that both the Payments and Hospitality services publish to.
# The consumer binds this exchange with routing keys: payment.* and reservation.*
RABBITMQ_EXCHANGE=hotel_events

# Consumer queue name (DLQ derived as <QUEUE>_dlq, DLX as <QUEUE>_dlx)
RABBITMQ_QUEUE=email_notifications

# Maximum unacknowledged messages per channel (back-pressure).
# Increase only if you scale to multiple worker processes with shared queues.
RABBITMQ_PREFETCH_COUNT=1

# -------------------
# Resend (Email Provider)
# -------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address used in all sent emails (must be a verified domain in Resend)
EMAIL_FROM=Hotel <noreply@yourdomain.com>

# -------------------
# Application
# -------------------
NODE_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
