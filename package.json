{
  "name": "hotel_messenger",
  "version": "1.0.0",
  "description": "Transactional Email Microservice for the hotel management system — EDA / RabbitMQ / Resend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "hotel",
    "email",
    "microservice",
    "rabbitmq",
    "resend",
    "event-driven"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "resend": "^6.26.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
