<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cancelamento de Reserva</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: #f4f5f7; font-family: 'Helvetica Neue', Arial, sans-serif; color: #2d3748; }

    .wrapper { max-width: 620px; margin: 0 auto; padding: 32px 16px; }
    .card { background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08); }

    /* Header — warm amber/orange palette for "cancellation/alert" */
    .header { background: linear-gradient(135deg, #744210 0%, #c05621 100%); padding: 40px 40px 32px; text-align: center; }
    .header .logo-text { font-size: 22px; font-weight: 700; color: #feebc8; letter-spacing: 0.08em; text-transform: uppercase; }
    .header h1 { font-size: 26px; font-weight: 700; color: #ffffff; margin-top: 12px; line-height: 1.3; }
    .header .badge { display: inline-block; background: rgba(255,255,255,0.15); color: #feebc8; border-radius: 999px; font-size: 12px; font-weight: 600; padding: 4px 14px; margin-top: 10px; letter-spacing: 0.05em; text-transform: uppercase; }

    .body { padding: 36px 40px; }
    .greeting { font-size: 17px; color: #4a5568; line-height: 1.6; margin-bottom: 28px; }
    .greeting strong { color: #744210; }

    /* Reservation code highlight */
    .res-code-block { text-align: center; background: #fffaf0; border: 2px solid #f6ad55; border-radius: 12px; padding: 20px; margin-bottom: 28px; }
    .res-code-label { font-size: 11px; font-weight: 700; color: #c05621; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px; }
    .res-code { font-size: 28px; font-weight: 800; color: #744210; letter-spacing: 0.12em; font-family: 'Courier New', monospace; }

    .info-grid { background: #fffaf0; border: 1px solid #f6ad55; border-radius: 10px; padding: 24px; margin-bottom: 28px; }
    .info-row { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1rem; padding: 10px 0; border-bottom: 1px solid #feebc8; }
    .info-row:last-child { border-bottom: none; padding-bottom: 0; }
    .info-label { font-size: 12px; font-weight: 600; color: #c05621; text-transform: uppercase; letter-spacing: 0.06em; }
    .info-value { font-size: 15px; font-weight: 600; color: #744210; text-align: right; max-width: 60%; }

    /* Refund notice */
    .refund-block { background: #f0fff4; border: 1px solid #9ae6b4; border-radius: 10px; padding: 18px 20px; margin-bottom: 24px; }
    .refund-block .refund-title { font-size: 13px; font-weight: 700; color: #276749; margin-bottom: 6px; }
    .refund-block p { font-size: 14px; color: #2f855a; line-height: 1.6; }

    .note { font-size: 14px; color: #718096; line-height: 1.7; margin-bottom: 16px; }

    .footer { background: #f7fafc; border-top: 1px solid #e2e8f0; padding: 24px 40px; text-align: center; }
    .footer p { font-size: 12px; color: #a0aec0; line-height: 1.6; }
    .footer a { color: #c05621; text-decoration: none; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="card">

      <!-- Header -->
      <div class="header">
        <div class="logo-text">Lúmen Hotel</div>
        <h1>Reserva Cancelada</h1>
      </div>

      <!-- Body -->
      <div class="body">

        <p class="greeting">
          Olá, <strong>{{guestName}}</strong>.<br/>
          Sua reserva foi cancelada. Abaixo estão os detalhes do cancelamento.
        </p>

        <!-- Reservation code -->
        <div class="res-code-block">
          <div class="res-code-label">Código da Reserva Cancelada</div>
          <div class="res-code">{{reservationCode}}</div>
        </div>

        <!-- Cancellation details -->
        <div class="info-grid">
          {{#if cancellationReason}}
          <div class="info-row">
            <span class="info-label">Motivo</span>
            <span class="info-value">{{cancellationReason}}</span>
          </div>
          {{/if}}
          <div class="info-row">
            <span class="info-label">Data do Cancelamento</span>
            <span class="info-value">{{cancellationDate}}</span>
          </div>
        </div>

        <!-- Refund section — shown only when refundAmountCents is present -->
        {{#if hasRefund}}
        <div class="refund-block">
          <div class="refund-title">💰 Informações sobre Reembolso</div>
          <p>
            Um reembolso de <strong>{{refundCurrency}} {{formattedRefundAmount}}</strong>
            será processado para a forma de pagamento original em até 7 dias úteis.
          </p>
        </div>
        {{else}}
        <p class="note">
          De acordo com nossa política de cancelamento, não haverá reembolso
          para esta reserva. Em caso de dúvidas, entre em contato conosco.
        </p>
        {{/if}}

        <p class="note">
          Esperamos poder recebê-lo em uma próxima oportunidade. Fique à vontade
          para realizar uma nova reserva em nosso site ou por telefone.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          Este é um e-mail automático. Por favor, não responda.<br/>
          © {{currentYear}} Grand Hotel. Todos os direitos reservados.<br/>
          <a href="#">Política de Privacidade</a> · <a href="#">Termos de Uso</a>
        </p>
      </div>

    </div>
  </div>
</body>
</html>
